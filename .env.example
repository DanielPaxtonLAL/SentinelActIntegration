# EMS URLs are server origins without /ems.
# Set the relevant INSECURE value to 1 only when certificate verification must be disabled.

# Production EMS Environment
PRODUCTION_EMS_URL=
PRODUCTION_EMS_INSECURE=1
PRODUCTION_EMS_API_VERSION=v90
PRODUCTION_EMS_USER_TYPE=ISV

# Test EMS Environment
TEST_EMS_URL=
TEST_EMS_INSECURE=0
TEST_EMS_API_VERSION=v90
TEST_EMS_USER_TYPE=ISV

# Shared EMS vendor ID
EMS_VENDOR_ID=2

# Act! connection
ACT_URL=
ACT_DATABASE=Irricad

# Integration Environment
# Default mode: true = test, false = production.
# Override for one run with: npm run dev -- --test
# Or: npm run dev -- --production
IS_TEST_MODE=false
INTEGRATION_PORT=3000
